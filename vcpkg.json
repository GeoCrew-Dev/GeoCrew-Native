{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "geocrew-native",
  "version": "0.1.0",
  "builtin-baseline": "116475f57043d9f1208fa22bbb4cf3277392ebae",
  "dependencies": [
    {
      "name": "gdal",
      "default-features": false,
      "features": ["expat", "geos", "iconv", "jpeg", "png", "sqlite3", "webp", "zstd"]
    },
    {
      "name": "proj",
      "default-features": false,
      "features": ["tiff"]
    },
    {
      "name": "sqlite3",
      "features": ["math", "rtree"]
    },
    {
      "name": "tiff",
      "features": ["webp", "zstd"]
    }
  ]
}
